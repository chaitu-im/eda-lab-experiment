        "\n",
        "n_80 = np.argmax(cumsum_var >= 0.80) + 1\n",
        "n_90 = np.argmax(cumsum_var >= 0.90) + 1\n",
        "n_95 = np.argmax(cumsum_var >= 0.95) + 1\n",
        "\n",
        "print(f\"Number of components needed for 80% of variance explained: {n_80}\")\n",
        "print(f\"Number of components needed for 90% of variance explained: {n_90}\")\n",
        "print(f\"Number of components needed for 95% of variance explained: {n_95}\")"
      ],
